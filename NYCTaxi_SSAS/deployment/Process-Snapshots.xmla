<Batch xmlns="http://schemas.microsoft.com/analysisservices/2003/engine" Transaction="true">
  <Parallel MaxParallel="2">
    <Process>
      <Object>
        <DatabaseID>NYCTaxi_SSAS</DatabaseID>
        <CubeID>Daily_Financial</CubeID>
        <MeasureGroupID>Daily Financial Snapshot</MeasureGroupID>
        <PartitionID>Daily Financial Snapshot All</PartitionID>
      </Object>
      <Type>ProcessFull</Type>
    </Process>
    <Process>
      <Object>
        <DatabaseID>NYCTaxi_SSAS</DatabaseID>
        <CubeID>Zone_Traffic</CubeID>
        <MeasureGroupID>Zone Traffic Snapshot</MeasureGroupID>
        <PartitionID>Zone Traffic Snapshot All</PartitionID>
      </Object>
      <Type>ProcessFull</Type>
    </Process>
    <Process>
      <Object>
        <DatabaseID>NYCTaxi_SSAS</DatabaseID>
        <CubeID>Base_Performance</CubeID>
        <MeasureGroupID>Base Performance Snapshot</MeasureGroupID>
        <PartitionID>Base Performance Snapshot All</PartitionID>
      </Object>
      <Type>ProcessFull</Type>
    </Process>
  </Parallel>
</Batch>
