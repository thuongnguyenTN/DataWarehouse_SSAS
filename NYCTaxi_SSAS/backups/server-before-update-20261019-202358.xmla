      <Schema>
        <xs:schema id="DSV_NYCTaxi" xmlns="" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata" xmlns:msprop="urn:schemas-microsoft-com:xml-msprop">
          <xs:element name="DSV_NYCTaxi" msdata:IsDataSet="true" msdata:UseCurrentLocale="true">
            <xs:complexType>
              <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="dbo_Fact_FHV_Trips" msprop:DbTableName="Fact_FHV_Trips" msprop:FriendlyName="Fact_FHV_Trips" msprop:TableType="Table" msprop:DbSchemaName="dbo">
                  <xs:complexType>
                    <xs:sequence>
                      <xs:element name="TripKey" msdata:ReadOnly="true" msdata:AutoIncrement="true" msprop:FriendlyName="TripKey" msprop:DbColumnName="TripKey" type="xs:long" />
                      <xs:element name="PickupDateKey" msprop:FriendlyName="PickupDateKey" msprop:DbColumnName="PickupDateKey" type="xs:int" />
                      <xs:element name="DropoffDateKey" msprop:FriendlyName="DropoffDateKey" msprop:DbColumnName="DropoffDateKey" type="xs:int" />
