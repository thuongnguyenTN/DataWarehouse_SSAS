                      <xs:element name="PickupLocationKey" msprop:FriendlyName="PickupLocationKey" msprop:DbColumnName="PickupLocationKey" type="xs:int" />
                      <xs:element name="DropoffLocationKey" msprop:FriendlyName="DropoffLocationKey" msprop:DbColumnName="DropoffLocationKey" type="xs:int" />
