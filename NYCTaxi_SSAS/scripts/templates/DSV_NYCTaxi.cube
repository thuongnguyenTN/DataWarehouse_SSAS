  <Source dwd:design-time-name="a3fd343a-82e0-4ce0-9a66-74345514f5a5">
    <DataSourceViewID>DSV_NYCTaxi_DWH</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="429486c0-b30d-4084-a2b3-bfdf265c4c72">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Total Trips All Services] AS CoalesceEmpty([Measures].[Trip Count],0) + CoalesceEmpty([Measures].[Trip Count - Fact HVFHV Trips],0) + CoalesceEmpty([Measures].[Trip Count - Fact Yellow Green Trips],0), FORMAT_STRING = '#,##0', DISPLAY_FOLDER = 'Overview', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[FHV Average Trip Duration Minutes] AS IIF(IsEmpty([Measures].[Fact FHV Trips TripDurationSecondsValidTrips]) OR [Measures].[Fact FHV Trips TripDurationSecondsValidTrips] = 0, NULL, ([Measures].[Trip Duration Seconds]) / ([Measures].[Fact FHV Trips TripDurationSecondsValidTrips]) * 0.016666666666666666), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'FHV', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[HVFHV Average Trip Duration Minutes] AS IIF(IsEmpty([Measures].[Fact HVFHV Trips TripDurationSecondsValidTrips]) OR [Measures].[Fact HVFHV Trips TripDurationSecondsValidTrips] = 0, NULL, ([Measures].[Trip Duration Seconds - Fact HVFHV Trips]) / ([Measures].[Fact HVFHV Trips TripDurationSecondsValidTrips]) * 0.016666666666666666), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'HVFHV', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[HVFHV Average Trip Distance] AS IIF(IsEmpty([Measures].[Fact HVFHV Trips TripDistanceMilesValidTrips]) OR [Measures].[Fact HVFHV Trips TripDistanceMilesValidTrips] = 0, NULL, ([Measures].[Trip Distance Miles]) / ([Measures].[Fact HVFHV Trips TripDistanceMilesValidTrips]) * 1), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'HVFHV', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[HVFHV Average Speed MPH] AS IIF(IsEmpty([Measures].[Fact HVFHV Trips SpeedDurationSeconds]) OR [Measures].[Fact HVFHV Trips SpeedDurationSeconds] = 0, NULL, ([Measures].[Fact HVFHV Trips SpeedDistanceMiles]) / ([Measures].[Fact HVFHV Trips SpeedDurationSeconds]) * 3600), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'HVFHV', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[HVFHV Average Fare Per Trip] AS IIF(IsEmpty([Measures].[Fact HVFHV Trips BasePassengerFareValidTrips]) OR [Measures].[Fact HVFHV Trips BasePassengerFareValidTrips] = 0, NULL, ([Measures].[Base Passenger Fare]) / ([Measures].[Fact HVFHV Trips BasePassengerFareValidTrips]) * 1), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'HVFHV', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[HVFHV Average Tip Per Trip] AS IIF(IsEmpty([Measures].[Fact HVFHV Trips TipAmountValidTrips]) OR [Measures].[Fact HVFHV Trips TipAmountValidTrips] = 0, NULL, ([Measures].[Tip Amount]) / ([Measures].[Fact HVFHV Trips TipAmountValidTrips]) * 1), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'HVFHV', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[HVFHV Tip Percentage] AS IIF(IsEmpty([Measures].[Fact HVFHV Trips TipPairFare]) OR [Measures].[Fact HVFHV Trips TipPairFare] = 0, NULL, ([Measures].[Fact HVFHV Trips TipPairAmount]) / ([Measures].[Fact HVFHV Trips TipPairFare]) * 1), FORMAT_STRING = '0.00%', DISPLAY_FOLDER = 'HVFHV', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[HVFHV Average Waiting Minutes] AS IIF(IsEmpty([Measures].[Fact HVFHV Trips WaitingTimeSecondsValidTrips]) OR [Measures].[Fact HVFHV Trips WaitingTimeSecondsValidTrips] = 0, NULL, ([Measures].[Waiting Time Seconds]) / ([Measures].[Fact HVFHV Trips WaitingTimeSecondsValidTrips]) * 0.016666666666666666), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'HVFHV', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[YellowGreen Average Trip Duration Minutes] AS IIF(IsEmpty([Measures].[Fact Yellow Green Trips TripDurationSecondsValidTrips]) OR [Measures].[Fact Yellow Green Trips TripDurationSecondsValidTrips] = 0, NULL, ([Measures].[Trip Duration Seconds - Fact Yellow Green Trips]) / ([Measures].[Fact Yellow Green Trips TripDurationSecondsValidTrips]) * 0.016666666666666666), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'YellowGreen', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[YellowGreen Average Trip Distance] AS IIF(IsEmpty([Measures].[Fact Yellow Green Trips TripDistanceMilesValidTrips]) OR [Measures].[Fact Yellow Green Trips TripDistanceMilesValidTrips] = 0, NULL, ([Measures].[Trip Distance Miles - Fact Yellow Green Trips]) / ([Measures].[Fact Yellow Green Trips TripDistanceMilesValidTrips]) * 1), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'YellowGreen', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[YellowGreen Average Speed MPH] AS IIF(IsEmpty([Measures].[Fact Yellow Green Trips SpeedDurationSeconds]) OR [Measures].[Fact Yellow Green Trips SpeedDurationSeconds] = 0, NULL, ([Measures].[Fact Yellow Green Trips SpeedDistanceMiles]) / ([Measures].[Fact Yellow Green Trips SpeedDurationSeconds]) * 3600), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'YellowGreen', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[YellowGreen Average Fare Per Trip] AS IIF(IsEmpty([Measures].[Fact Yellow Green Trips FareAmountValidTrips]) OR [Measures].[Fact Yellow Green Trips FareAmountValidTrips] = 0, NULL, ([Measures].[Fare Amount]) / ([Measures].[Fact Yellow Green Trips FareAmountValidTrips]) * 1), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'YellowGreen', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[YellowGreen Average Tip Per Trip] AS IIF(IsEmpty([Measures].[Fact Yellow Green Trips TipAmountValidTrips]) OR [Measures].[Fact Yellow Green Trips TipAmountValidTrips] = 0, NULL, ([Measures].[Tip Amount - Fact Yellow Green Trips]) / ([Measures].[Fact Yellow Green Trips TipAmountValidTrips]) * 1), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'YellowGreen', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[YellowGreen Tip Percentage] AS IIF(IsEmpty([Measures].[Fact Yellow Green Trips TipPairFare]) OR [Measures].[Fact Yellow Green Trips TipPairFare] = 0, NULL, ([Measures].[Fact Yellow Green Trips TipPairAmount]) / ([Measures].[Fact Yellow Green Trips TipPairFare]) * 1), FORMAT_STRING = '0.00%', DISPLAY_FOLDER = 'YellowGreen', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Base Average Duration Minutes] AS IIF(IsEmpty([Measures].[Base Performance Snapshot DurationTripCount]) OR [Measures].[Base Performance Snapshot DurationTripCount] = 0, NULL, ([Measures].[Base Performance Snapshot TotalTripDurationSeconds]) / ([Measures].[Base Performance Snapshot DurationTripCount]) * 0.016666666666666666), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'Base Performance', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Base Average Waiting Minutes] AS IIF(IsEmpty([Measures].[Base Performance Snapshot WaitingTripCount]) OR [Measures].[Base Performance Snapshot WaitingTripCount] = 0, NULL, ([Measures].[Base Performance Snapshot TotalWaitingTimeSeconds]) / ([Measures].[Base Performance Snapshot WaitingTripCount]) * 0.016666666666666666), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'Base Performance', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Shared Request Rate] AS IIF(IsEmpty(([Measures].[Base Performance Snapshot TotalTrips], [Dim Service Type].[Service Code].&amp;[FHVHV])) OR ([Measures].[Base Performance Snapshot TotalTrips], [Dim Service Type].[Service Code].&amp;[FHVHV]) = 0, NULL, (([Measures].[Base Performance Snapshot TotalSharedRequests], [Dim Service Type].[Service Code].&amp;[FHVHV])) / (([Measures].[Base Performance Snapshot TotalTrips], [Dim Service Type].[Service Code].&amp;[FHVHV])) * 1), FORMAT_STRING = '0.00%', DISPLAY_FOLDER = 'Base Performance', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[WAV Match Rate] AS IIF(IsEmpty([Measures].[Base Performance Snapshot TotalWAVRequests]) OR [Measures].[Base Performance Snapshot TotalWAVRequests] = 0, NULL, ([Measures].[Base Performance Snapshot TotalWAVMatches]) / ([Measures].[Base Performance Snapshot TotalWAVRequests]) * 1), FORMAT_STRING = '0.00%', DISPLAY_FOLDER = 'Base Performance', VISIBLE = 1;</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>