<?xml version='1.0' encoding='UTF-8'?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts" DTS:refId="Package" DTS:CreationDate="10/11/2026 5:04:15 PM" DTS:CreationName="Microsoft.Package" DTS:CreatorComputerName="THUONGNGUYEN" DTS:CreatorName="THUONGNGUYEN\ADMIN" DTS:DTSID="{26DDE3C6-72C4-4EBF-ABA9-8773A0EA956B}" DTS:ExecutableType="Microsoft.Package" DTS:LastModifiedProductVersion="17.0.1016.0" DTS:LocaleID="1033" DTS:ObjectName="PKG_03_Load_DWH" DTS:PackageType="5" DTS:VersionBuild="3" DTS:VersionGUID="{CC9AA213-5D12-4110-A65A-C2E5C6452833}">
  <DTS:Property DTS:Name="PackageFormatVersion">8</DTS:Property>
  <DTS:Variables/>
  <DTS:Executables>
    <DTS:Executable DTS:refId="Package\EST_00_Precheck_DWH" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="EST_00_Precheck_DWH - SQL Server transactional load" DTS:DTSID="{B8F83559-BB01-413D-A252-A797A03D0714}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="EST_00_Precheck_DWH" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables/>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{4A829E7F-DE39-4A39-83D3-52CE94E192E2}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;IF DB_ID(N'NYCTaxi_Staging') IS NULL OR DB_ID(N'NYCTaxi_DWH') IS NULL&#10;    THROW 55001, 'Missing database NYCTaxi_Staging or NYCTaxi_DWH.', 1;&#10;IF OBJECT_ID(N'NYCTaxi_Staging.clean.ValidTrip',N'V') IS NULL&#10;    THROW 55002, 'Missing NYCTaxi_Staging.clean.ValidTrip; run Transform first.', 1;&#10;IF OBJECT_ID(N'NYCTaxi_Staging.clean.TaxiZone',N'U') IS NULL&#10;    THROW 55003, 'Missing clean.TaxiZone.', 1;&#10;IF OBJECT_ID(N'dbo.Fact_YellowGreen_Trips',N'U') IS NULL&#10; OR OBJECT_ID(N'dbo.Fact_FHV_Trips',N'U') IS NULL&#10; OR OBJECT_ID(N'dbo.Fact_HVFHV_Trips',N'U') IS NULL&#10;    THROW 55004, 'Missing transactional Fact tables; run 04_create_nyctaxi_dwh.sql.', 1;&#10;IF NOT EXISTS(SELECT 1 FROM dbo.Dim_Time WHERE MinuteOfDay=0 AND TimeKey=1)&#10; OR NOT EXISTS(SELECT 1 FROM dbo.Dim_Time WHERE MinuteOfDay=1439 AND TimeKey=1440)&#10;    THROW 55005, 'Dim_Time not initialized (TimeKey must be MinuteOfDay + 1).',1;&#10;IF NOT EXISTS(SELECT 1 FROM NYCTaxi_Staging.clean.ValidTrip)&#10;    THROW 55006, 'No valid trips in clean.ValidTrip.', 1;&#10;IF EXISTS(SELECT 1 FROM dbo.Fact_YellowGreen_Trips WHERE RecordHash IS NULL)&#10; OR EXISTS(SELECT 1 FROM dbo.Fact_FHV_Trips WHERE RecordHash IS NULL)&#10; OR EXISTS(SELECT 1 FROM dbo.Fact_HVFHV_Trips WHERE RecordHash IS NULL)&#10;    THROW 55007, 'Legacy Fact rows have NULL RecordHash. Perform a ONE-TIME migration/reset after backup.', 1;&#10;IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = N'etl')&#10;    EXEC(N'CREATE SCHEMA etl AUTHORIZATION dbo');&#10;IF OBJECT_ID(N'etl.LoadStepLog',N'U') IS NULL&#10;    CREATE TABLE etl.LoadStepLog&#10;    (&#10;        LogID BIGINT IDENTITY(1,1) NOT NULL PRIMARY KEY,&#10;        StepName NVARCHAR(100) NOT NULL,&#10;        InsertedRows BIGINT NULL,&#10;        CompletedAt DATETIME2(0) NOT NULL DEFAULT SYSDATETIME()&#10;    );&#10;IF NOT EXISTS(SELECT 1 FROM sys.indexes WHERE object_id=OBJECT_ID(N'dbo.Fact_YellowGreen_Trips') AND name=N'UX_FYG_RecordHash')&#10;    CREATE UNIQUE INDEX UX_FYG_RecordHash ON dbo.Fact_YellowGreen_Trips(RecordHash) WHERE RecordHash IS NOT NULL;&#10;IF NOT EXISTS(SELECT 1 FROM sys.indexes WHERE object_id=OBJECT_ID(N'dbo.Fact_FHV_Trips') AND name=N'UX_FHV_RecordHash')&#10;    CREATE UNIQUE INDEX UX_FHV_RecordHash ON dbo.Fact_FHV_Trips(RecordHash) WHERE RecordHash IS NOT NULL;&#10;IF NOT EXISTS(SELECT 1 FROM sys.indexes WHERE object_id=OBJECT_ID(N'dbo.Fact_HVFHV_Trips') AND name=N'UX_HVFHV_RecordHash')&#10;    CREATE UNIQUE INDEX UX_HVFHV_RecordHash ON dbo.Fact_HVFHV_Trips(RecordHash) WHERE RecordHash IS NOT NULL;&#10;&#10;IF OBJECT_ID('etl.FactChangeAudit','U') IS NULL CREATE TABLE etl.FactChangeAudit(&#10; AuditId bigint IDENTITY PRIMARY KEY,TableName sysname NOT NULL,RowJson nvarchar(max) NOT NULL,&#10; DeletedAt datetime2 NOT NULL DEFAULT SYSUTCDATETIME());&#10;IF COL_LENGTH('dbo.Fact_YellowGreen_Trips','SourceDataset') IS NULL ALTER TABLE dbo.Fact_YellowGreen_Trips ADD SourceDataset varchar(20) NULL;&#10;IF COL_LENGTH('dbo.Fact_YellowGreen_Trips','SourceKey') IS NULL ALTER TABLE dbo.Fact_YellowGreen_Trips ADD SourceKey nvarchar(260) NULL;&#10;IF COL_LENGTH('dbo.Fact_FHV_Trips','SourceDataset') IS NULL ALTER TABLE dbo.Fact_FHV_Trips ADD SourceDataset varchar(20) NULL;&#10;IF COL_LENGTH('dbo.Fact_FHV_Trips','SourceKey') IS NULL ALTER TABLE dbo.Fact_FHV_Trips ADD SourceKey nvarchar(260) NULL;&#10;IF COL_LENGTH('dbo.Fact_HVFHV_Trips','SourceDataset') IS NULL ALTER TABLE dbo.Fact_HVFHV_Trips ADD SourceDataset varchar(20) NULL;&#10;IF COL_LENGTH('dbo.Fact_HVFHV_Trips','SourceKey') IS NULL ALTER TABLE dbo.Fact_HVFHV_Trips ADD SourceKey nvarchar(260) NULL;&#10;"/>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\EST_01_Load_Dimensions" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="EST_01_Load_Dimensions - SQL Server transactional load" DTS:DTSID="{2A46897D-EFF9-484D-BD2D-81D8CFA66D6E}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="EST_01_Load_Dimensions" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables/>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{4A829E7F-DE39-4A39-83D3-52CE94E192E2}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10; BEGIN TRAN;&#10; -- All physical Dimension tables and their Unknown members come from 04_create_nyctaxi_dwh.sql.&#10; -- 1) SCD Type 1: Taxi Zone lookup&#10; INSERT INTO dbo.Dim_Location(LocationID,Borough,ZoneName,ServiceZone)&#10; SELECT S.LocationID,S.Borough,S.Zone,S.ServiceZone&#10; FROM NYCTaxi_Staging.clean.TaxiZone S&#10; WHERE S.LocationID IS NOT NULL&#10;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_Location D WITH (UPDLOCK,HOLDLOCK) WHERE D.LocationID=S.LocationID);&#10; UPDATE D SET D.Borough=S.Borough, D.ZoneName=S.Zone, D.ServiceZone=S.ServiceZone&#10; FROM dbo.Dim_Location D JOIN NYCTaxi_Staging.clean.TaxiZone S ON S.LocationID=D.LocationID&#10; WHERE EXISTS (SELECT D.Borough,D.ZoneName,D.ServiceZone EXCEPT SELECT S.Borough,S.Zone,S.ServiceZone);&#10; -- 2) Codes used by all four source types&#10; INSERT dbo.Dim_ServiceType(ServiceCode,ServiceName)&#10; SELECT V.Code,V.Name&#10; FROM (VALUES ('YELLOW',N'Yellow Taxi'),('GREEN',N'Green Taxi'),&#10;              ('FHV',N'For-Hire Vehicle'),('FHVHV',N'High Volume FHV')) V(Code,Name)&#10; WHERE NOT EXISTS(SELECT 1 FROM dbo.Dim_ServiceType D WHERE D.ServiceCode=V.Code);&#10; INSERT dbo.Dim_Vendor(VendorID)&#10; SELECT DISTINCT C.VendorID FROM NYCTaxi_Staging.clean.ValidTrip C&#10; WHERE C.TaxiType IN('YELLOW','GREEN') AND C.VendorID IS NOT NULL&#10;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_Vendor D WHERE D.VendorID=C.VendorID);&#10; INSERT dbo.Dim_RateCode(RateCodeID)&#10; SELECT DISTINCT C.RateCodeID FROM NYCTaxi_Staging.clean.ValidTrip C&#10; WHERE C.TaxiType IN('YELLOW','GREEN') AND C.RateCodeID IS NOT NULL&#10;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_RateCode D WHERE D.RateCodeID=C.RateCodeID);&#10; INSERT dbo.Dim_PaymentType(PaymentTypeID)&#10; SELECT DISTINCT C.PaymentTypeID FROM NYCTaxi_Staging.clean.ValidTrip C&#10; WHERE C.TaxiType IN('YELLOW','GREEN') AND C.PaymentTypeID IS NOT NULL&#10;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_PaymentType D WHERE D.PaymentTypeID=C.PaymentTypeID);&#10; INSERT dbo.Dim_TripType(TripTypeID)&#10; SELECT DISTINCT C.TripTypeID FROM NYCTaxi_Staging.clean.ValidTrip C&#10; WHERE C.TaxiType='GREEN' AND C.TripTypeID IS NOT NULL&#10;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_TripType D WHERE D.TripTypeID=C.TripTypeID);&#10; INSERT dbo.Dim_HVFHSProvider(LicenseNumber)&#10; SELECT DISTINCT C.HVFHSLicenseNum FROM NYCTaxi_Staging.clean.ValidTrip C&#10; WHERE C.TaxiType='FHVHV' AND C.HVFHSLicenseNum IS NOT NULL&#10;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_HVFHSProvider D WHERE D.LicenseNumber=C.HVFHSLicenseNum);&#10; ;WITH Bases AS&#10; (&#10;   SELECT DispatchingBaseNum AS BaseNumber FROM NYCTaxi_Staging.clean.ValidTrip&#10;   UNION SELECT OriginatingBaseNum FROM NYCTaxi_Staging.clean.ValidTrip&#10;   UNION SELECT AffiliatedBaseNum FROM NYCTaxi_Staging.clean.ValidTrip&#10; )&#10; INSERT dbo.Dim_Base(BaseNumber)&#10; SELECT B.BaseNumber FROM Bases B&#10; WHERE B.BaseNumber IS NOT NULL&#10;   AND NOT EXISTS(SELECT 1 FROM dbo.Dim_Base D WHERE D.BaseNumber=B.BaseNumber);&#10; -- 3) Junk dimensions&#10; INSERT dbo.Dim_TaxiFlags(StoreAndFwd)&#10; SELECT DISTINCT CASE WHEN UPPER(C.StoreAndFwdFlag) IN('Y','N') THEN UPPER(C.StoreAndFwdFlag) ELSE 'U' END&#10; FROM NYCTaxi_Staging.clean.ValidTrip C WHERE C.TaxiType IN('YELLOW','GREEN')&#10; AND NOT EXISTS (SELECT 1 FROM dbo.Dim_TaxiFlags D&#10;     WHERE D.StoreAndFwd=CASE WHEN UPPER(C.StoreAndFwdFlag) IN('Y','N') THEN UPPER(C.StoreAndFwdFlag) ELSE 'U' END);&#10; INSERT dbo.Dim_FHVFlags(IsSharedRide)&#10; SELECT DISTINCT CASE WHEN UPPER(C.SharedRequestFlag) IN('Y','N') THEN UPPER(C.SharedRequestFlag) ELSE 'U' END&#10; FROM NYCTaxi_Staging.clean.ValidTrip C WHERE C.TaxiType='FHV'&#10; AND NOT EXISTS (SELECT 1 FROM dbo.Dim_FHVFlags D&#10;     WHERE D.IsSharedRide=CASE WHEN UPPER(C.SharedRequestFlag) IN('Y','N') THEN UPPER(C.SharedRequestFlag) ELSE 'U' END);&#10; ;WITH F AS&#10; (&#10;   SELECT DISTINCT&#10;    CASE WHEN UPPER(SharedRequestFlag) IN('Y','N') THEN UPPER(SharedRequestFlag) ELSE 'U' END AS R,&#10;    CASE WHEN UPPER(SharedMatchFlag) IN('Y','N') THEN UPPER(SharedMatchFlag) ELSE 'U' END AS M,&#10;    CASE WHEN UPPER(AccessARideFlag) IN('Y','N') THEN UPPER(AccessARideFlag) ELSE 'U' END AS A,&#10;    CASE WHEN UPPER(WAVRequestFlag) IN('Y','N') THEN UPPER(WAVRequestFlag) ELSE 'U' END AS WR,&#10;    CASE WHEN UPPER(WAVMatchFlag) IN('Y','N') THEN UPPER(WAVMatchFlag) ELSE 'U' END AS WM&#10;   FROM NYCTaxi_Staging.clean.ValidTrip WHERE TaxiType='FHVHV'&#10; )&#10; INSERT dbo.Dim_HVFHVFlags(IsSharedRequest,IsSharedMatch,IsAccessARide,IsWAVRequest,IsWAVMatch)&#10; SELECT F.R,F.M,F.A,F.WR,F.WM FROM F&#10; WHERE NOT EXISTS (SELECT 1 FROM dbo.Dim_HVFHVFlags D&#10;    WHERE D.IsSharedRequest=F.R AND D.IsSharedMatch=F.M AND D.IsAccessARide=F.A&#10;    AND D.IsWAVRequest=F.WR AND D.IsWAVMatch=F.WM);&#10; -- 4) Add dates outside seed period; IsHoliday=0 until a reliable calendar is provided.&#10; ;WITH Dates AS&#10; (&#10;    SELECT CONVERT(date,PickupDateTime) AS FullDate FROM NYCTaxi_Staging.clean.ValidTrip&#10;    UNION SELECT CONVERT(date,DropoffDateTime) FROM NYCTaxi_Staging.clean.ValidTrip&#10;    UNION SELECT CONVERT(date,RequestDateTime) FROM NYCTaxi_Staging.clean.ValidTrip WHERE RequestDateTime IS NOT NULL&#10;    UNION SELECT CONVERT(date,OnSceneDateTime) FROM NYCTaxi_Staging.clean.ValidTrip WHERE OnSceneDateTime IS NOT NULL&#10; )&#10; INSERT dbo.Dim_Date(DateKey,FullDate,DayOfWeekNumber,DayOfWeekName,DayOfMonth,MonthNumber,&#10;                      MonthName,QuarterNumber,YearNumber,IsWeekend,IsHoliday)&#10; SELECT YEAR(X.FullDate)*10000+MONTH(X.FullDate)*100+DAY(X.FullDate),X.FullDate,&#10;        CONVERT(tinyint,DATEDIFF(DAY,'19000101',X.FullDate)%7+1),&#10;        DATENAME(WEEKDAY,X.FullDate),CONVERT(tinyint,DAY(X.FullDate)),&#10;        CONVERT(tinyint,MONTH(X.FullDate)),DATENAME(MONTH,X.FullDate),&#10;        CONVERT(tinyint,DATEPART(QUARTER,X.FullDate)),CONVERT(smallint,YEAR(X.FullDate)),&#10;        CASE WHEN DATEDIFF(DAY,'19000101',X.FullDate)%7 IN(5,6) THEN 1 ELSE 0 END,0&#10; FROM Dates X WHERE X.FullDate BETWEEN '20000101' AND '20991231'&#10; AND NOT EXISTS(SELECT 1 FROM dbo.Dim_Date D WHERE D.FullDate=X.FullDate);&#10; -- 5) Monthly processing groups inferred from pickup dates (NOT actual file lineage).&#10; ;WITH B AS&#10; (&#10;    SELECT DISTINCT C.TaxiType,&#10;         YEAR(C.PickupDateTime) AS YY,MONTH(C.PickupDateTime) AS MM,&#10;         CONCAT('CLEAN-',C.TaxiType,'-',CONVERT(char(6),C.PickupDateTime,112)) AS BatchID&#10;    FROM NYCTaxi_Staging.clean.ValidTrip C&#10;    WHERE C.PickupDateTime IS NOT NULL&#10; )&#10; INSERT dbo.Dim_LoadBatch(BatchID,DatasetName,SourceFileName,SourceYear,SourceMonth,LoadedAt,BatchStatus)&#10; SELECT B.BatchID,B.TaxiType,NULL,B.YY,B.MM,SYSDATETIME(),'READY'&#10; FROM B WHERE NOT EXISTS(SELECT 1 FROM dbo.Dim_LoadBatch D WHERE D.BatchID=B.BatchID);&#10; COMMIT TRAN;&#10;END TRY&#10;BEGIN CATCH&#10; IF @@TRANCOUNT&gt;0 ROLLBACK;&#10; THROW;&#10;END CATCH;&#10;"/>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\EST_02_Load_FactYellowGreen" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="EST_02_Load_FactYellowGreen - SQL Server transactional load" DTS:DTSID="{2FCC6B61-7740-4EA8-97CA-CCB34F108292}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="EST_02_Load_FactYellowGreen" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables/>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{4A829E7F-DE39-4A39-83D3-52CE94E192E2}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10; BEGIN TRAN;&#10;;WITH SourceRows AS&#10;(&#10;  SELECT C.*,&#10;    HASHBYTES('SHA2_256',&#10;      (SELECT C.TaxiType AS TaxiType,&#10;            C.VendorID AS VendorID,&#10;            C.HVFHSLicenseNum AS HVFHSLicenseNum,&#10;            C.DispatchingBaseNum AS DispatchingBaseNum,&#10;            C.OriginatingBaseNum AS OriginatingBaseNum,&#10;            C.AffiliatedBaseNum AS AffiliatedBaseNum,&#10;            C.RequestDateTime AS RequestDateTime,&#10;            C.OnSceneDateTime AS OnSceneDateTime,&#10;            C.PickupDateTime AS PickupDateTime,&#10;            C.DropoffDateTime AS DropoffDateTime,&#10;            C.TripDurationSeconds AS TripDurationSeconds,&#10;            C.PULocationID AS PULocationID,&#10;            C.DOLocationID AS DOLocationID,&#10;            C.PassengerCount AS PassengerCount,&#10;            C.TripDistanceMiles AS TripDistanceMiles,&#10;            C.RateCodeID AS RateCodeID,&#10;            C.PaymentTypeID AS PaymentTypeID,&#10;            C.TripTypeID AS TripTypeID,&#10;            C.StoreAndFwdFlag AS StoreAndFwdFlag,&#10;            C.FareAmount AS FareAmount,&#10;            C.ExtraAmount AS ExtraAmount,&#10;            C.MTATaxAmount AS MTATaxAmount,&#10;            C.TipAmount AS TipAmount,&#10;            C.TollsAmount AS TollsAmount,&#10;            C.ImprovementSurcharge AS ImprovementSurcharge,&#10;            C.CongestionSurcharge AS CongestionSurcharge,&#10;            C.AirportFee AS AirportFee,&#10;            C.CBDCongestionFee AS CBDCongestionFee,&#10;            C.BCFAmount AS BCFAmount,&#10;            C.SalesTaxAmount AS SalesTaxAmount,&#10;            C.DriverPayAmount AS DriverPayAmount,&#10;            C.TotalAmount AS TotalAmount,&#10;            C.IsTotalCalculated AS IsTotalCalculated,&#10;            C.SharedRequestFlag AS SharedRequestFlag,&#10;            C.SharedMatchFlag AS SharedMatchFlag,&#10;            C.AccessARideFlag AS AccessARideFlag,&#10;            C.WAVRequestFlag AS WAVRequestFlag,&#10;            C.WAVMatchFlag AS WAVMatchFlag&#10;       FOR JSON PATH, WITHOUT_ARRAY_WRAPPER, INCLUDE_NULL_VALUES)&#10;    ) AS PayloadHash&#10;  FROM NYCTaxi_Staging.clean.ValidTrip C&#10;  WHERE C.TaxiType IN ('YELLOW','GREEN')&#10;),&#10;Ranked AS&#10;(&#10;  SELECT S.*, ROW_NUMBER() OVER(PARTITION BY S.PayloadHash ORDER BY S.TripCleanID) AS DuplicateOrdinal&#10;  FROM SourceRows S&#10;),&#10;Tagged AS&#10;(&#10;  SELECT R.*,&#10;    HASHBYTES('SHA2_256', CONCAT(CONVERT(varchar(64),R.PayloadHash,2),':',R.DuplicateOrdinal)) AS RecordHash&#10;  FROM Ranked R&#10;),&#10;FactValues AS (&#10;SELECT&#10;    COALESCE(PickupDate.DateKey, 0) AS PickupDateKey,&#10;    COALESCE(DropoffDate.DateKey, 0) AS DropoffDateKey,&#10;&#10;    COALESCE(PickupTime.TimeKey, 0) AS PickupTimeKey,&#10;    COALESCE(DropoffTime.TimeKey, 0) AS DropoffTimeKey,&#10;&#10;    COALESCE(PickupZone.LocationKey, 0) AS PickupLocationKey,&#10;    COALESCE(DropoffZone.LocationKey, 0) AS DropoffLocationKey,&#10;&#10;    COALESCE(ServiceType.ServiceTypeKey, 0) AS ServiceTypeKey,&#10;    COALESCE(Vendor.VendorKey, 0) AS VendorKey,&#10;    COALESCE(RateCode.RateCodeKey, 0) AS RateCodeKey,&#10;    COALESCE(Payment.PaymentTypeKey, 0) AS PaymentTypeKey,&#10;    COALESCE(TripType.TripTypeKey, 0) AS TripTypeKey,&#10;    COALESCE(TaxiFlag.TaxiFlagKey, 0) AS TaxiFlagKey,&#10;    COALESCE(PassengerGroup.PassengerGroupKey, 0)&#10;        AS PassengerGroupKey,&#10;&#10;    COALESCE(LoadBatch.LoadBatchKey,0) AS LoadBatchKey,&#10;    1 AS TripCount,&#10;&#10;    C.PassengerCount,&#10;    C.TripDistanceMiles,&#10;    C.TripDurationSeconds,&#10;&#10;    CASE&#10;        WHEN C.TripDurationSeconds &gt; 0&#10;             AND C.TripDistanceMiles &gt;= 0&#10;        THEN CONVERT&#10;        (&#10;            DECIMAL(12,3),&#10;            C.TripDistanceMiles * 3600.0&#10;            / C.TripDurationSeconds&#10;        )&#10;        ELSE NULL&#10;    END AS AverageSpeedMPH,&#10;&#10;    C.FareAmount,&#10;    C.ExtraAmount,&#10;    C.MTATaxAmount,&#10;    C.TipAmount,&#10;    C.TollsAmount,&#10;    C.ImprovementSurcharge,&#10;    C.CongestionSurcharge,&#10;    C.AirportFee,&#10;    C.CBDCongestionFee,&#10;    C.TotalAmount,&#10;    C.RecordHash AS RecordHash, LOWER(C.TaxiType) AS SourceDataset, C.ETLSourceKey AS SourceKey&#10;&#10;FROM Tagged AS C&#10;&#10;LEFT JOIN dbo.Dim_Date AS PickupDate&#10;    ON PickupDate.FullDate =&#10;       CONVERT(DATE, C.PickupDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Date AS DropoffDate&#10;    ON DropoffDate.FullDate =&#10;       CONVERT(DATE, C.DropoffDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Time AS PickupTime&#10;    ON PickupTime.MinuteOfDay =&#10;       DATEPART(HOUR, C.PickupDateTime) * 60&#10;       + DATEPART(MINUTE, C.PickupDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Time AS DropoffTime&#10;    ON DropoffTime.MinuteOfDay =&#10;       DATEPART(HOUR, C.DropoffDateTime) * 60&#10;       + DATEPART(MINUTE, C.DropoffDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Location AS PickupZone&#10;    ON PickupZone.LocationID = C.PULocationID&#10;&#10;LEFT JOIN dbo.Dim_Location AS DropoffZone&#10;    ON DropoffZone.LocationID = C.DOLocationID&#10;&#10;LEFT JOIN dbo.Dim_ServiceType AS ServiceType&#10;    ON ServiceType.ServiceCode = C.TaxiType&#10;&#10;LEFT JOIN dbo.Dim_Vendor AS Vendor&#10;    ON Vendor.VendorID = C.VendorID&#10;&#10;LEFT JOIN dbo.Dim_RateCode AS RateCode&#10;    ON RateCode.RateCodeID = C.RateCodeID&#10;&#10;LEFT JOIN dbo.Dim_PaymentType AS Payment&#10;    ON Payment.PaymentTypeID = C.PaymentTypeID&#10;&#10;LEFT JOIN dbo.Dim_TripType AS TripType&#10;    ON TripType.TripTypeID = C.TripTypeID&#10;&#10;LEFT JOIN dbo.Dim_TaxiFlags AS TaxiFlag&#10;    ON TaxiFlag.StoreAndFwd =&#10;       CASE&#10;           WHEN UPPER(C.StoreAndFwdFlag) IN ('Y', 'N')&#10;               THEN UPPER(C.StoreAndFwdFlag)&#10;           ELSE 'U'&#10;       END&#10;&#10;LEFT JOIN dbo.Dim_PassengerGroup AS PassengerGroup&#10;    ON C.PassengerCount BETWEEN&#10;       PassengerGroup.MinCount AND PassengerGroup.MaxCount&#10;&#10;LEFT JOIN dbo.Dim_LoadBatch AS LoadBatch&#10;    ON LoadBatch.BatchID = CONCAT('CLEAN-',C.TaxiType,'-',CONVERT(char(6),C.PickupDateTime,112))&#10;&#10;WHERE C.TaxiType IN ('YELLOW', 'GREEN')&#10;)&#10;    SELECT * INTO #Desired FROM FactValues;&#10;    CREATE UNIQUE CLUSTERED INDEX IX_Desired_Hash ON #Desired(RecordHash);&#10;    IF EXISTS(SELECT 1 FROM #Desired WHERE SourceKey IS NULL)&#10;        THROW 55910,'Clean source lineage is missing; refusing fact reconciliation.',1;&#10;    UPDATE F SET SourceDataset=V.SourceDataset,SourceKey=V.SourceKey&#10;      FROM dbo.Fact_YellowGreen_Trips F JOIN #Desired V ON V.RecordHash=F.RecordHash&#10;      WHERE F.SourceKey IS NULL OR F.SourceKey&lt;&gt;V.SourceKey OR F.SourceDataset&lt;&gt;V.SourceDataset;&#10;    IF EXISTS(SELECT 1 FROM dbo.Fact_YellowGreen_Trips WHERE SourceKey IS NULL)&#10;        THROW 55911,'Unmapped legacy facts exist. Restore clean history or perform reviewed migration; no automatic deletion.',1;&#10;    INSERT etl.FactChangeAudit(TableName,RowJson)&#10;      SELECT N'Fact_YellowGreen_Trips',(SELECT F.* FOR JSON PATH,WITHOUT_ARRAY_WRAPPER)&#10;      FROM dbo.Fact_YellowGreen_Trips F&#10;      WHERE NOT EXISTS(SELECT 1 FROM #Desired V WHERE V.RecordHash=F.RecordHash)&#10;        AND EXISTS(SELECT 1 FROM NYCTaxi_Staging.etl.ExtractFileLog L&#10;          WHERE L.DatasetCode=F.SourceDataset AND L.SourceKey=F.SourceKey AND L.LoadStatus='SUCCEEDED');&#10;    DELETE F FROM dbo.Fact_YellowGreen_Trips F&#10;      WHERE NOT EXISTS(SELECT 1 FROM #Desired V WHERE V.RecordHash=F.RecordHash)&#10;        AND EXISTS(SELECT 1 FROM NYCTaxi_Staging.etl.ExtractFileLog L&#10;          WHERE L.DatasetCode=F.SourceDataset AND L.SourceKey=F.SourceKey AND L.LoadStatus='SUCCEEDED');&#10;    UPDATE F SET PickupDateKey=V.PickupDateKey,DropoffDateKey=V.DropoffDateKey,PickupTimeKey=V.PickupTimeKey,DropoffTimeKey=V.DropoffTimeKey,PickupLocationKey=V.PickupLocationKey,DropoffLocationKey=V.DropoffLocationKey,ServiceTypeKey=V.ServiceTypeKey,VendorKey=V.VendorKey,RateCodeKey=V.RateCodeKey,PaymentTypeKey=V.PaymentTypeKey,TripTypeKey=V.TripTypeKey,TaxiFlagKey=V.TaxiFlagKey,PassengerGroupKey=V.PassengerGroupKey,LoadBatchKey=V.LoadBatchKey,TripCount=V.TripCount,PassengerCount=V.PassengerCount,TripDistanceMiles=V.TripDistanceMiles,TripDurationSeconds=V.TripDurationSeconds,AverageSpeedMPH=V.AverageSpeedMPH,FareAmount=V.FareAmount,ExtraAmount=V.ExtraAmount,MTATaxAmount=V.MTATaxAmount,TipAmount=V.TipAmount,TollsAmount=V.TollsAmount,ImprovementSurcharge=V.ImprovementSurcharge,CongestionSurcharge=V.CongestionSurcharge,AirportFee=V.AirportFee,CBDCongestionFee=V.CBDCongestionFee,TotalAmount=V.TotalAmount,SourceDataset=V.SourceDataset,SourceKey=V.SourceKey FROM dbo.Fact_YellowGreen_Trips F JOIN #Desired V ON V.RecordHash=F.RecordHash WHERE EXISTS (SELECT F.PickupDateKey,F.DropoffDateKey,F.PickupTimeKey,F.DropoffTimeKey,F.PickupLocationKey,F.DropoffLocationKey,F.ServiceTypeKey,F.VendorKey,F.RateCodeKey,F.PaymentTypeKey,F.TripTypeKey,F.TaxiFlagKey,F.PassengerGroupKey,F.LoadBatchKey,F.TripCount,F.PassengerCount,F.TripDistanceMiles,F.TripDurationSeconds,F.AverageSpeedMPH,F.FareAmount,F.ExtraAmount,F.MTATaxAmount,F.TipAmount,F.TollsAmount,F.ImprovementSurcharge,F.CongestionSurcharge,F.AirportFee,F.CBDCongestionFee,F.TotalAmount,F.SourceDataset,F.SourceKey EXCEPT SELECT V.PickupDateKey,V.DropoffDateKey,V.PickupTimeKey,V.DropoffTimeKey,V.PickupLocationKey,V.DropoffLocationKey,V.ServiceTypeKey,V.VendorKey,V.RateCodeKey,V.PaymentTypeKey,V.TripTypeKey,V.TaxiFlagKey,V.PassengerGroupKey,V.LoadBatchKey,V.TripCount,V.PassengerCount,V.TripDistanceMiles,V.TripDurationSeconds,V.AverageSpeedMPH,V.FareAmount,V.ExtraAmount,V.MTATaxAmount,V.TipAmount,V.TollsAmount,V.ImprovementSurcharge,V.CongestionSurcharge,V.AirportFee,V.CBDCongestionFee,V.TotalAmount,V.SourceDataset,V.SourceKey);&#10;    INSERT INTO dbo.Fact_YellowGreen_Trips&#10;    (PickupDateKey, DropoffDateKey, PickupTimeKey, DropoffTimeKey, PickupLocationKey, DropoffLocationKey, ServiceTypeKey, VendorKey, RateCodeKey, PaymentTypeKey, TripTypeKey, TaxiFlagKey, PassengerGroupKey, LoadBatchKey, TripCount, PassengerCount, TripDistanceMiles, TripDurationSeconds, AverageSpeedMPH, FareAmount, ExtraAmount, MTATaxAmount, TipAmount, TollsAmount, ImprovementSurcharge, CongestionSurcharge, AirportFee, CBDCongestionFee, TotalAmount, RecordHash, SourceDataset, SourceKey)&#10;    SELECT V.PickupDateKey, V.DropoffDateKey, V.PickupTimeKey, V.DropoffTimeKey, V.PickupLocationKey, V.DropoffLocationKey, V.ServiceTypeKey, V.VendorKey, V.RateCodeKey, V.PaymentTypeKey, V.TripTypeKey, V.TaxiFlagKey, V.PassengerGroupKey, V.LoadBatchKey, V.TripCount, V.PassengerCount, V.TripDistanceMiles, V.TripDurationSeconds, V.AverageSpeedMPH, V.FareAmount, V.ExtraAmount, V.MTATaxAmount, V.TipAmount, V.TollsAmount, V.ImprovementSurcharge, V.CongestionSurcharge, V.AirportFee, V.CBDCongestionFee, V.TotalAmount, V.RecordHash, V.SourceDataset, V.SourceKey&#10;    FROM #Desired V&#10;    WHERE NOT EXISTS&#10;      (SELECT 1 FROM dbo.Fact_YellowGreen_Trips F WITH (UPDLOCK,HOLDLOCK) WHERE F.RecordHash=V.RecordHash);&#10;    DECLARE @InsertedRows bigint = @@ROWCOUNT;&#10;    INSERT etl.LoadStepLog(StepName,InsertedRows)&#10;    VALUES('Fact_YellowGreen_Trips',@InsertedRows);&#10;&#10; DROP TABLE #Desired;&#10; COMMIT TRAN;&#10;END TRY&#10;BEGIN CATCH&#10; IF @@TRANCOUNT&gt;0 ROLLBACK;&#10; THROW;&#10;END CATCH;&#10;"/>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\EST_03_Load_FactFHV" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="EST_03_Load_FactFHV - SQL Server transactional load" DTS:DTSID="{BCE5A58B-69AC-4C94-99EC-57D97CF62B2A}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="EST_03_Load_FactFHV" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables/>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{4A829E7F-DE39-4A39-83D3-52CE94E192E2}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10; BEGIN TRAN;&#10;;WITH SourceRows AS&#10;(&#10;  SELECT C.*,&#10;    HASHBYTES('SHA2_256',&#10;      (SELECT C.TaxiType AS TaxiType,&#10;            C.VendorID AS VendorID,&#10;            C.HVFHSLicenseNum AS HVFHSLicenseNum,&#10;            C.DispatchingBaseNum AS DispatchingBaseNum,&#10;            C.OriginatingBaseNum AS OriginatingBaseNum,&#10;            C.AffiliatedBaseNum AS AffiliatedBaseNum,&#10;            C.RequestDateTime AS RequestDateTime,&#10;            C.OnSceneDateTime AS OnSceneDateTime,&#10;            C.PickupDateTime AS PickupDateTime,&#10;            C.DropoffDateTime AS DropoffDateTime,&#10;            C.TripDurationSeconds AS TripDurationSeconds,&#10;            C.PULocationID AS PULocationID,&#10;            C.DOLocationID AS DOLocationID,&#10;            C.PassengerCount AS PassengerCount,&#10;            C.TripDistanceMiles AS TripDistanceMiles,&#10;            C.RateCodeID AS RateCodeID,&#10;            C.PaymentTypeID AS PaymentTypeID,&#10;            C.TripTypeID AS TripTypeID,&#10;            C.StoreAndFwdFlag AS StoreAndFwdFlag,&#10;            C.FareAmount AS FareAmount,&#10;            C.ExtraAmount AS ExtraAmount,&#10;            C.MTATaxAmount AS MTATaxAmount,&#10;            C.TipAmount AS TipAmount,&#10;            C.TollsAmount AS TollsAmount,&#10;            C.ImprovementSurcharge AS ImprovementSurcharge,&#10;            C.CongestionSurcharge AS CongestionSurcharge,&#10;            C.AirportFee AS AirportFee,&#10;            C.CBDCongestionFee AS CBDCongestionFee,&#10;            C.BCFAmount AS BCFAmount,&#10;            C.SalesTaxAmount AS SalesTaxAmount,&#10;            C.DriverPayAmount AS DriverPayAmount,&#10;            C.TotalAmount AS TotalAmount,&#10;            C.IsTotalCalculated AS IsTotalCalculated,&#10;            C.SharedRequestFlag AS SharedRequestFlag,&#10;            C.SharedMatchFlag AS SharedMatchFlag,&#10;            C.AccessARideFlag AS AccessARideFlag,&#10;            C.WAVRequestFlag AS WAVRequestFlag,&#10;            C.WAVMatchFlag AS WAVMatchFlag&#10;       FOR JSON PATH, WITHOUT_ARRAY_WRAPPER, INCLUDE_NULL_VALUES)&#10;    ) AS PayloadHash&#10;  FROM NYCTaxi_Staging.clean.ValidTrip C&#10;  WHERE C.TaxiType='FHV'&#10;),&#10;Ranked AS&#10;(&#10;  SELECT S.*, ROW_NUMBER() OVER(PARTITION BY S.PayloadHash ORDER BY S.TripCleanID) AS DuplicateOrdinal&#10;  FROM SourceRows S&#10;),&#10;Tagged AS&#10;(&#10;  SELECT R.*,&#10;    HASHBYTES('SHA2_256', CONCAT(CONVERT(varchar(64),R.PayloadHash,2),':',R.DuplicateOrdinal)) AS RecordHash&#10;  FROM Ranked R&#10;),&#10;FactValues AS (&#10;SELECT&#10;    COALESCE(PickupDate.DateKey, 0) AS PickupDateKey,&#10;    COALESCE(DropoffDate.DateKey, 0) AS DropoffDateKey,&#10;&#10;    COALESCE(PickupTime.TimeKey, 0) AS PickupTimeKey,&#10;    COALESCE(DropoffTime.TimeKey, 0) AS DropoffTimeKey,&#10;&#10;    COALESCE(PickupZone.LocationKey, 0)&#10;        AS PickupLocationKey,&#10;&#10;    COALESCE(DropoffZone.LocationKey, 0)&#10;        AS DropoffLocationKey,&#10;&#10;    COALESCE(ServiceType.ServiceTypeKey, 0)&#10;        AS ServiceTypeKey,&#10;&#10;    COALESCE(DispatchBase.BaseKey, 0)&#10;        AS DispatchBaseKey,&#10;&#10;    COALESCE(AffiliatedBase.BaseKey, 0)&#10;        AS AffiliatedBaseKey,&#10;&#10;    COALESCE(FHVFlag.FHVFlagKey, 0)&#10;        AS FHVFlagKey,&#10;&#10;    COALESCE(LoadBatch.LoadBatchKey,0) AS LoadBatchKey,&#10;    1 AS TripCount,&#10;&#10;    C.TripDurationSeconds,&#10;    C.RecordHash AS RecordHash, LOWER(C.TaxiType) AS SourceDataset, C.ETLSourceKey AS SourceKey&#10;&#10;FROM Tagged AS C&#10;&#10;LEFT JOIN dbo.Dim_Date AS PickupDate&#10;    ON PickupDate.FullDate =&#10;       CONVERT(DATE, C.PickupDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Date AS DropoffDate&#10;    ON DropoffDate.FullDate =&#10;       CONVERT(DATE, C.DropoffDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Time AS PickupTime&#10;    ON PickupTime.MinuteOfDay =&#10;       DATEPART(HOUR, C.PickupDateTime) * 60&#10;       + DATEPART(MINUTE, C.PickupDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Time AS DropoffTime&#10;    ON DropoffTime.MinuteOfDay =&#10;       DATEPART(HOUR, C.DropoffDateTime) * 60&#10;       + DATEPART(MINUTE, C.DropoffDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Location AS PickupZone&#10;    ON PickupZone.LocationID = C.PULocationID&#10;&#10;LEFT JOIN dbo.Dim_Location AS DropoffZone&#10;    ON DropoffZone.LocationID = C.DOLocationID&#10;&#10;LEFT JOIN dbo.Dim_ServiceType AS ServiceType&#10;    ON ServiceType.ServiceCode = C.TaxiType&#10;&#10;LEFT JOIN dbo.Dim_Base AS DispatchBase&#10;    ON DispatchBase.BaseNumber = C.DispatchingBaseNum&#10;&#10;LEFT JOIN dbo.Dim_Base AS AffiliatedBase&#10;    ON AffiliatedBase.BaseNumber = C.AffiliatedBaseNum&#10;&#10;LEFT JOIN dbo.Dim_FHVFlags AS FHVFlag&#10;    ON FHVFlag.IsSharedRide =&#10;       CASE&#10;           WHEN UPPER(C.SharedRequestFlag) IN ('Y', 'N')&#10;               THEN UPPER(C.SharedRequestFlag)&#10;           ELSE 'U'&#10;       END&#10;&#10;LEFT JOIN dbo.Dim_LoadBatch AS LoadBatch&#10;    ON LoadBatch.BatchID = CONCAT('CLEAN-',C.TaxiType,'-',CONVERT(char(6),C.PickupDateTime,112))&#10;&#10;WHERE C.TaxiType = 'FHV'&#10;)&#10;    SELECT * INTO #Desired FROM FactValues;&#10;    CREATE UNIQUE CLUSTERED INDEX IX_Desired_Hash ON #Desired(RecordHash);&#10;    IF EXISTS(SELECT 1 FROM #Desired WHERE SourceKey IS NULL)&#10;        THROW 55910,'Clean source lineage is missing; refusing fact reconciliation.',1;&#10;    UPDATE F SET SourceDataset=V.SourceDataset,SourceKey=V.SourceKey&#10;      FROM dbo.Fact_FHV_Trips F JOIN #Desired V ON V.RecordHash=F.RecordHash&#10;      WHERE F.SourceKey IS NULL OR F.SourceKey&lt;&gt;V.SourceKey OR F.SourceDataset&lt;&gt;V.SourceDataset;&#10;    IF EXISTS(SELECT 1 FROM dbo.Fact_FHV_Trips WHERE SourceKey IS NULL)&#10;        THROW 55911,'Unmapped legacy facts exist. Restore clean history or perform reviewed migration; no automatic deletion.',1;&#10;    INSERT etl.FactChangeAudit(TableName,RowJson)&#10;      SELECT N'Fact_FHV_Trips',(SELECT F.* FOR JSON PATH,WITHOUT_ARRAY_WRAPPER)&#10;      FROM dbo.Fact_FHV_Trips F&#10;      WHERE NOT EXISTS(SELECT 1 FROM #Desired V WHERE V.RecordHash=F.RecordHash)&#10;        AND EXISTS(SELECT 1 FROM NYCTaxi_Staging.etl.ExtractFileLog L&#10;          WHERE L.DatasetCode=F.SourceDataset AND L.SourceKey=F.SourceKey AND L.LoadStatus='SUCCEEDED');&#10;    DELETE F FROM dbo.Fact_FHV_Trips F&#10;      WHERE NOT EXISTS(SELECT 1 FROM #Desired V WHERE V.RecordHash=F.RecordHash)&#10;        AND EXISTS(SELECT 1 FROM NYCTaxi_Staging.etl.ExtractFileLog L&#10;          WHERE L.DatasetCode=F.SourceDataset AND L.SourceKey=F.SourceKey AND L.LoadStatus='SUCCEEDED');&#10;    UPDATE F SET PickupDateKey=V.PickupDateKey,DropoffDateKey=V.DropoffDateKey,PickupTimeKey=V.PickupTimeKey,DropoffTimeKey=V.DropoffTimeKey,PickupLocationKey=V.PickupLocationKey,DropoffLocationKey=V.DropoffLocationKey,ServiceTypeKey=V.ServiceTypeKey,DispatchBaseKey=V.DispatchBaseKey,AffiliatedBaseKey=V.AffiliatedBaseKey,FHVFlagKey=V.FHVFlagKey,LoadBatchKey=V.LoadBatchKey,TripCount=V.TripCount,TripDurationSeconds=V.TripDurationSeconds,SourceDataset=V.SourceDataset,SourceKey=V.SourceKey FROM dbo.Fact_FHV_Trips F JOIN #Desired V ON V.RecordHash=F.RecordHash WHERE EXISTS (SELECT F.PickupDateKey,F.DropoffDateKey,F.PickupTimeKey,F.DropoffTimeKey,F.PickupLocationKey,F.DropoffLocationKey,F.ServiceTypeKey,F.DispatchBaseKey,F.AffiliatedBaseKey,F.FHVFlagKey,F.LoadBatchKey,F.TripCount,F.TripDurationSeconds,F.SourceDataset,F.SourceKey EXCEPT SELECT V.PickupDateKey,V.DropoffDateKey,V.PickupTimeKey,V.DropoffTimeKey,V.PickupLocationKey,V.DropoffLocationKey,V.ServiceTypeKey,V.DispatchBaseKey,V.AffiliatedBaseKey,V.FHVFlagKey,V.LoadBatchKey,V.TripCount,V.TripDurationSeconds,V.SourceDataset,V.SourceKey);&#10;    INSERT INTO dbo.Fact_FHV_Trips&#10;    (PickupDateKey, DropoffDateKey, PickupTimeKey, DropoffTimeKey, PickupLocationKey, DropoffLocationKey, ServiceTypeKey, DispatchBaseKey, AffiliatedBaseKey, FHVFlagKey, LoadBatchKey, TripCount, TripDurationSeconds, RecordHash, SourceDataset, SourceKey)&#10;    SELECT V.PickupDateKey, V.DropoffDateKey, V.PickupTimeKey, V.DropoffTimeKey, V.PickupLocationKey, V.DropoffLocationKey, V.ServiceTypeKey, V.DispatchBaseKey, V.AffiliatedBaseKey, V.FHVFlagKey, V.LoadBatchKey, V.TripCount, V.TripDurationSeconds, V.RecordHash, V.SourceDataset, V.SourceKey&#10;    FROM #Desired V&#10;    WHERE NOT EXISTS&#10;      (SELECT 1 FROM dbo.Fact_FHV_Trips F WITH (UPDLOCK,HOLDLOCK) WHERE F.RecordHash=V.RecordHash);&#10;    DECLARE @InsertedRows bigint = @@ROWCOUNT;&#10;    INSERT etl.LoadStepLog(StepName,InsertedRows)&#10;    VALUES('Fact_FHV_Trips',@InsertedRows);&#10;&#10; DROP TABLE #Desired;&#10; COMMIT TRAN;&#10;END TRY&#10;BEGIN CATCH&#10; IF @@TRANCOUNT&gt;0 ROLLBACK;&#10; THROW;&#10;END CATCH;&#10;"/>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\EST_04_Load_FactHVFHV" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="EST_04_Load_FactHVFHV - SQL Server transactional load" DTS:DTSID="{535A0299-ECA9-4BB2-928F-B77FD3205770}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="EST_04_Load_FactHVFHV" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables/>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{4A829E7F-DE39-4A39-83D3-52CE94E192E2}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;SET XACT_ABORT ON;&#10;BEGIN TRY&#10; BEGIN TRAN;&#10;;WITH SourceRows AS&#10;(&#10;  SELECT C.*,&#10;    HASHBYTES('SHA2_256',&#10;      (SELECT C.TaxiType AS TaxiType,&#10;            C.VendorID AS VendorID,&#10;            C.HVFHSLicenseNum AS HVFHSLicenseNum,&#10;            C.DispatchingBaseNum AS DispatchingBaseNum,&#10;            C.OriginatingBaseNum AS OriginatingBaseNum,&#10;            C.AffiliatedBaseNum AS AffiliatedBaseNum,&#10;            C.RequestDateTime AS RequestDateTime,&#10;            C.OnSceneDateTime AS OnSceneDateTime,&#10;            C.PickupDateTime AS PickupDateTime,&#10;            C.DropoffDateTime AS DropoffDateTime,&#10;            C.TripDurationSeconds AS TripDurationSeconds,&#10;            C.PULocationID AS PULocationID,&#10;            C.DOLocationID AS DOLocationID,&#10;            C.PassengerCount AS PassengerCount,&#10;            C.TripDistanceMiles AS TripDistanceMiles,&#10;            C.RateCodeID AS RateCodeID,&#10;            C.PaymentTypeID AS PaymentTypeID,&#10;            C.TripTypeID AS TripTypeID,&#10;            C.StoreAndFwdFlag AS StoreAndFwdFlag,&#10;            C.FareAmount AS FareAmount,&#10;            C.ExtraAmount AS ExtraAmount,&#10;            C.MTATaxAmount AS MTATaxAmount,&#10;            C.TipAmount AS TipAmount,&#10;            C.TollsAmount AS TollsAmount,&#10;            C.ImprovementSurcharge AS ImprovementSurcharge,&#10;            C.CongestionSurcharge AS CongestionSurcharge,&#10;            C.AirportFee AS AirportFee,&#10;            C.CBDCongestionFee AS CBDCongestionFee,&#10;            C.BCFAmount AS BCFAmount,&#10;            C.SalesTaxAmount AS SalesTaxAmount,&#10;            C.DriverPayAmount AS DriverPayAmount,&#10;            C.TotalAmount AS TotalAmount,&#10;            C.IsTotalCalculated AS IsTotalCalculated,&#10;            C.SharedRequestFlag AS SharedRequestFlag,&#10;            C.SharedMatchFlag AS SharedMatchFlag,&#10;            C.AccessARideFlag AS AccessARideFlag,&#10;            C.WAVRequestFlag AS WAVRequestFlag,&#10;            C.WAVMatchFlag AS WAVMatchFlag&#10;       FOR JSON PATH, WITHOUT_ARRAY_WRAPPER, INCLUDE_NULL_VALUES)&#10;    ) AS PayloadHash&#10;  FROM NYCTaxi_Staging.clean.ValidTrip C&#10;  WHERE C.TaxiType='FHVHV'&#10;),&#10;Ranked AS&#10;(&#10;  SELECT S.*, ROW_NUMBER() OVER(PARTITION BY S.PayloadHash ORDER BY S.TripCleanID) AS DuplicateOrdinal&#10;  FROM SourceRows S&#10;),&#10;Tagged AS&#10;(&#10;  SELECT R.*,&#10;    HASHBYTES('SHA2_256', CONCAT(CONVERT(varchar(64),R.PayloadHash,2),':',R.DuplicateOrdinal)) AS RecordHash&#10;  FROM Ranked R&#10;),&#10;C AS&#10;(&#10;    SELECT&#10;        T.*,&#10;&#10;        CASE&#10;            WHEN UPPER(T.SharedRequestFlag) IN ('Y', 'N')&#10;                THEN UPPER(T.SharedRequestFlag)&#10;            ELSE 'U'&#10;        END AS NormalizedSharedRequest,&#10;&#10;        CASE&#10;            WHEN UPPER(T.SharedMatchFlag) IN ('Y', 'N')&#10;                THEN UPPER(T.SharedMatchFlag)&#10;            ELSE 'U'&#10;        END AS NormalizedSharedMatch,&#10;&#10;        CASE&#10;            WHEN UPPER(T.AccessARideFlag) IN ('Y', 'N')&#10;                THEN UPPER(T.AccessARideFlag)&#10;            ELSE 'U'&#10;        END AS NormalizedAccessARide,&#10;&#10;        CASE&#10;            WHEN UPPER(T.WAVRequestFlag) IN ('Y', 'N')&#10;                THEN UPPER(T.WAVRequestFlag)&#10;            ELSE 'U'&#10;        END AS NormalizedWAVRequest,&#10;&#10;        CASE&#10;            WHEN UPPER(T.WAVMatchFlag) IN ('Y', 'N')&#10;                THEN UPPER(T.WAVMatchFlag)&#10;            ELSE 'U'&#10;        END AS NormalizedWAVMatch&#10;&#10;    FROM Tagged AS T&#10;    WHERE T.TaxiType = 'FHVHV'&#10;),&#10;FactValues AS (&#10;SELECT&#10;    COALESCE(RequestDate.DateKey, 0) AS RequestDateKey,&#10;    COALESCE(OnSceneDate.DateKey, 0) AS OnSceneDateKey,&#10;    COALESCE(PickupDate.DateKey, 0) AS PickupDateKey,&#10;    COALESCE(DropoffDate.DateKey, 0) AS DropoffDateKey,&#10;&#10;    COALESCE(RequestTime.TimeKey, 0) AS RequestTimeKey,&#10;    COALESCE(OnSceneTime.TimeKey, 0) AS OnSceneTimeKey,&#10;    COALESCE(PickupTime.TimeKey, 0) AS PickupTimeKey,&#10;    COALESCE(DropoffTime.TimeKey, 0) AS DropoffTimeKey,&#10;&#10;    COALESCE(PickupZone.LocationKey, 0)&#10;        AS PickupLocationKey,&#10;&#10;    COALESCE(DropoffZone.LocationKey, 0)&#10;        AS DropoffLocationKey,&#10;&#10;    COALESCE(ServiceType.ServiceTypeKey, 0)&#10;        AS ServiceTypeKey,&#10;&#10;    COALESCE(Provider.HVFHSProviderKey, 0)&#10;        AS HVFHSProviderKey,&#10;&#10;    COALESCE(DispatchBase.BaseKey, 0)&#10;        AS DispatchBaseKey,&#10;&#10;    COALESCE(OriginBase.BaseKey, 0)&#10;        AS OriginBaseKey,&#10;&#10;    COALESCE(Flags.HVFHVFlagKey, 0)&#10;        AS HVFHVFlagKey,&#10;&#10;    COALESCE(LoadBatch.LoadBatchKey,0) AS LoadBatchKey,&#10;    1 AS TripCount,&#10;&#10;    C.TripDistanceMiles,&#10;    C.TripDurationSeconds,&#10;&#10;    CASE&#10;        WHEN C.RequestDateTime IS NOT NULL&#10;         AND C.PickupDateTime &gt;= C.RequestDateTime&#10;        THEN DATEDIFF_BIG(&#10;            SECOND,&#10;            C.RequestDateTime,&#10;            C.PickupDateTime&#10;        )&#10;    END AS WaitingTimeSeconds,&#10;&#10;    CASE&#10;        WHEN C.OnSceneDateTime IS NOT NULL&#10;         AND C.PickupDateTime &gt;= C.OnSceneDateTime&#10;        THEN DATEDIFF_BIG(&#10;            SECOND,&#10;            C.OnSceneDateTime,&#10;            C.PickupDateTime&#10;        )&#10;    END AS OnSceneToPickupSeconds,&#10;&#10;    C.FareAmount AS BasePassengerFare,&#10;    C.TollsAmount,&#10;    C.BCFAmount,&#10;    C.SalesTaxAmount,&#10;    C.CongestionSurcharge,&#10;    C.AirportFee,&#10;    C.TipAmount,&#10;    C.DriverPayAmount,&#10;    C.CBDCongestionFee,&#10;    C.TotalAmount AS GrossPassengerAmount,&#10;    C.RecordHash AS RecordHash, LOWER(C.TaxiType) AS SourceDataset, C.ETLSourceKey AS SourceKey&#10;&#10;FROM C&#10;&#10;LEFT JOIN dbo.Dim_Date AS RequestDate&#10;    ON RequestDate.FullDate =&#10;       CONVERT(DATE, C.RequestDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Date AS OnSceneDate&#10;    ON OnSceneDate.FullDate =&#10;       CONVERT(DATE, C.OnSceneDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Date AS PickupDate&#10;    ON PickupDate.FullDate =&#10;       CONVERT(DATE, C.PickupDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Date AS DropoffDate&#10;    ON DropoffDate.FullDate =&#10;       CONVERT(DATE, C.DropoffDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Time AS RequestTime&#10;    ON RequestTime.MinuteOfDay =&#10;       DATEPART(HOUR, C.RequestDateTime) * 60&#10;       + DATEPART(MINUTE, C.RequestDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Time AS OnSceneTime&#10;    ON OnSceneTime.MinuteOfDay =&#10;       DATEPART(HOUR, C.OnSceneDateTime) * 60&#10;       + DATEPART(MINUTE, C.OnSceneDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Time AS PickupTime&#10;    ON PickupTime.MinuteOfDay =&#10;       DATEPART(HOUR, C.PickupDateTime) * 60&#10;       + DATEPART(MINUTE, C.PickupDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Time AS DropoffTime&#10;    ON DropoffTime.MinuteOfDay =&#10;       DATEPART(HOUR, C.DropoffDateTime) * 60&#10;       + DATEPART(MINUTE, C.DropoffDateTime)&#10;&#10;LEFT JOIN dbo.Dim_Location AS PickupZone&#10;    ON PickupZone.LocationID = C.PULocationID&#10;&#10;LEFT JOIN dbo.Dim_Location AS DropoffZone&#10;    ON DropoffZone.LocationID = C.DOLocationID&#10;&#10;LEFT JOIN dbo.Dim_ServiceType AS ServiceType&#10;    ON ServiceType.ServiceCode = C.TaxiType&#10;&#10;LEFT JOIN dbo.Dim_HVFHSProvider AS Provider&#10;    ON Provider.LicenseNumber = C.HVFHSLicenseNum&#10;&#10;LEFT JOIN dbo.Dim_Base AS DispatchBase&#10;    ON DispatchBase.BaseNumber = C.DispatchingBaseNum&#10;&#10;LEFT JOIN dbo.Dim_Base AS OriginBase&#10;    ON OriginBase.BaseNumber = C.OriginatingBaseNum&#10;&#10;LEFT JOIN dbo.Dim_HVFHVFlags AS Flags&#10;    ON Flags.IsSharedRequest = C.NormalizedSharedRequest&#10;   AND Flags.IsSharedMatch = C.NormalizedSharedMatch&#10;   AND Flags.IsAccessARide = C.NormalizedAccessARide&#10;   AND Flags.IsWAVRequest = C.NormalizedWAVRequest&#10;   AND Flags.IsWAVMatch = C.NormalizedWAVMatch&#10;LEFT JOIN dbo.Dim_LoadBatch AS LoadBatch&#10;    ON LoadBatch.BatchID = CONCAT('CLEAN-',C.TaxiType,'-',CONVERT(char(6),C.PickupDateTime,112))&#10;&#10;)&#10;    SELECT * INTO #Desired FROM FactValues;&#10;    CREATE UNIQUE CLUSTERED INDEX IX_Desired_Hash ON #Desired(RecordHash);&#10;    IF EXISTS(SELECT 1 FROM #Desired WHERE SourceKey IS NULL)&#10;        THROW 55910,'Clean source lineage is missing; refusing fact reconciliation.',1;&#10;    UPDATE F SET SourceDataset=V.SourceDataset,SourceKey=V.SourceKey&#10;      FROM dbo.Fact_HVFHV_Trips F JOIN #Desired V ON V.RecordHash=F.RecordHash&#10;      WHERE F.SourceKey IS NULL OR F.SourceKey&lt;&gt;V.SourceKey OR F.SourceDataset&lt;&gt;V.SourceDataset;&#10;    IF EXISTS(SELECT 1 FROM dbo.Fact_HVFHV_Trips WHERE SourceKey IS NULL)&#10;        THROW 55911,'Unmapped legacy facts exist. Restore clean history or perform reviewed migration; no automatic deletion.',1;&#10;    INSERT etl.FactChangeAudit(TableName,RowJson)&#10;      SELECT N'Fact_HVFHV_Trips',(SELECT F.* FOR JSON PATH,WITHOUT_ARRAY_WRAPPER)&#10;      FROM dbo.Fact_HVFHV_Trips F&#10;      WHERE NOT EXISTS(SELECT 1 FROM #Desired V WHERE V.RecordHash=F.RecordHash)&#10;        AND EXISTS(SELECT 1 FROM NYCTaxi_Staging.etl.ExtractFileLog L&#10;          WHERE L.DatasetCode=F.SourceDataset AND L.SourceKey=F.SourceKey AND L.LoadStatus='SUCCEEDED');&#10;    DELETE F FROM dbo.Fact_HVFHV_Trips F&#10;      WHERE NOT EXISTS(SELECT 1 FROM #Desired V WHERE V.RecordHash=F.RecordHash)&#10;        AND EXISTS(SELECT 1 FROM NYCTaxi_Staging.etl.ExtractFileLog L&#10;          WHERE L.DatasetCode=F.SourceDataset AND L.SourceKey=F.SourceKey AND L.LoadStatus='SUCCEEDED');&#10;    UPDATE F SET RequestDateKey=V.RequestDateKey,OnSceneDateKey=V.OnSceneDateKey,PickupDateKey=V.PickupDateKey,DropoffDateKey=V.DropoffDateKey,RequestTimeKey=V.RequestTimeKey,OnSceneTimeKey=V.OnSceneTimeKey,PickupTimeKey=V.PickupTimeKey,DropoffTimeKey=V.DropoffTimeKey,PickupLocationKey=V.PickupLocationKey,DropoffLocationKey=V.DropoffLocationKey,ServiceTypeKey=V.ServiceTypeKey,HVFHSProviderKey=V.HVFHSProviderKey,DispatchBaseKey=V.DispatchBaseKey,OriginBaseKey=V.OriginBaseKey,HVFHVFlagKey=V.HVFHVFlagKey,LoadBatchKey=V.LoadBatchKey,TripCount=V.TripCount,TripDistanceMiles=V.TripDistanceMiles,TripDurationSeconds=V.TripDurationSeconds,WaitingTimeSeconds=V.WaitingTimeSeconds,OnSceneToPickupSeconds=V.OnSceneToPickupSeconds,BasePassengerFare=V.BasePassengerFare,TollsAmount=V.TollsAmount,BCFAmount=V.BCFAmount,SalesTaxAmount=V.SalesTaxAmount,CongestionSurcharge=V.CongestionSurcharge,AirportFee=V.AirportFee,TipAmount=V.TipAmount,DriverPayAmount=V.DriverPayAmount,CBDCongestionFee=V.CBDCongestionFee,GrossPassengerAmount=V.GrossPassengerAmount,SourceDataset=V.SourceDataset,SourceKey=V.SourceKey FROM dbo.Fact_HVFHV_Trips F JOIN #Desired V ON V.RecordHash=F.RecordHash WHERE EXISTS (SELECT F.RequestDateKey,F.OnSceneDateKey,F.PickupDateKey,F.DropoffDateKey,F.RequestTimeKey,F.OnSceneTimeKey,F.PickupTimeKey,F.DropoffTimeKey,F.PickupLocationKey,F.DropoffLocationKey,F.ServiceTypeKey,F.HVFHSProviderKey,F.DispatchBaseKey,F.OriginBaseKey,F.HVFHVFlagKey,F.LoadBatchKey,F.TripCount,F.TripDistanceMiles,F.TripDurationSeconds,F.WaitingTimeSeconds,F.OnSceneToPickupSeconds,F.BasePassengerFare,F.TollsAmount,F.BCFAmount,F.SalesTaxAmount,F.CongestionSurcharge,F.AirportFee,F.TipAmount,F.DriverPayAmount,F.CBDCongestionFee,F.GrossPassengerAmount,F.SourceDataset,F.SourceKey EXCEPT SELECT V.RequestDateKey,V.OnSceneDateKey,V.PickupDateKey,V.DropoffDateKey,V.RequestTimeKey,V.OnSceneTimeKey,V.PickupTimeKey,V.DropoffTimeKey,V.PickupLocationKey,V.DropoffLocationKey,V.ServiceTypeKey,V.HVFHSProviderKey,V.DispatchBaseKey,V.OriginBaseKey,V.HVFHVFlagKey,V.LoadBatchKey,V.TripCount,V.TripDistanceMiles,V.TripDurationSeconds,V.WaitingTimeSeconds,V.OnSceneToPickupSeconds,V.BasePassengerFare,V.TollsAmount,V.BCFAmount,V.SalesTaxAmount,V.CongestionSurcharge,V.AirportFee,V.TipAmount,V.DriverPayAmount,V.CBDCongestionFee,V.GrossPassengerAmount,V.SourceDataset,V.SourceKey);&#10;    INSERT INTO dbo.Fact_HVFHV_Trips&#10;    (RequestDateKey, OnSceneDateKey, PickupDateKey, DropoffDateKey, RequestTimeKey, OnSceneTimeKey, PickupTimeKey, DropoffTimeKey, PickupLocationKey, DropoffLocationKey, ServiceTypeKey, HVFHSProviderKey, DispatchBaseKey, OriginBaseKey, HVFHVFlagKey, LoadBatchKey, TripCount, TripDistanceMiles, TripDurationSeconds, WaitingTimeSeconds, OnSceneToPickupSeconds, BasePassengerFare, TollsAmount, BCFAmount, SalesTaxAmount, CongestionSurcharge, AirportFee, TipAmount, DriverPayAmount, CBDCongestionFee, GrossPassengerAmount, RecordHash, SourceDataset, SourceKey)&#10;    SELECT V.RequestDateKey, V.OnSceneDateKey, V.PickupDateKey, V.DropoffDateKey, V.RequestTimeKey, V.OnSceneTimeKey, V.PickupTimeKey, V.DropoffTimeKey, V.PickupLocationKey, V.DropoffLocationKey, V.ServiceTypeKey, V.HVFHSProviderKey, V.DispatchBaseKey, V.OriginBaseKey, V.HVFHVFlagKey, V.LoadBatchKey, V.TripCount, V.TripDistanceMiles, V.TripDurationSeconds, V.WaitingTimeSeconds, V.OnSceneToPickupSeconds, V.BasePassengerFare, V.TollsAmount, V.BCFAmount, V.SalesTaxAmount, V.CongestionSurcharge, V.AirportFee, V.TipAmount, V.DriverPayAmount, V.CBDCongestionFee, V.GrossPassengerAmount, V.RecordHash, V.SourceDataset, V.SourceKey&#10;    FROM #Desired V&#10;    WHERE NOT EXISTS&#10;      (SELECT 1 FROM dbo.Fact_HVFHV_Trips F WITH (UPDLOCK,HOLDLOCK) WHERE F.RecordHash=V.RecordHash);&#10;    DECLARE @InsertedRows bigint = @@ROWCOUNT;&#10;    INSERT etl.LoadStepLog(StepName,InsertedRows)&#10;    VALUES('Fact_HVFHV_Trips',@InsertedRows);&#10;&#10; DROP TABLE #Desired;&#10; COMMIT TRAN;&#10;END TRY&#10;BEGIN CATCH&#10; IF @@TRANCOUNT&gt;0 ROLLBACK;&#10; THROW;&#10;END CATCH;&#10;"/>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable DTS:refId="Package\EST_05_Validate_DWH" DTS:CreationName="Microsoft.ExecuteSQLTask" DTS:Description="EST_05_Validate_DWH - SQL Server transactional load" DTS:DTSID="{658FFD06-E89E-44F1-B834-7D187FC4BD03}" DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:LocaleID="-1" DTS:ObjectName="EST_05_Validate_DWH" DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1" DTS:ThreadHint="0">
      <DTS:Variables/>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" SQLTask:Connection="{4A829E7F-DE39-4A39-83D3-52CE94E192E2}" SQLTask:SqlStatementSource="SET NOCOUNT ON;&#10;-- Source can be a subset of historical data, so only compare a lower bound.&#10;DECLARE @CleanTaxi bigint=(SELECT COUNT_BIG(*) FROM NYCTaxi_Staging.clean.ValidTrip WHERE TaxiType IN('YELLOW','GREEN'));&#10;DECLARE @CleanFHV bigint=(SELECT COUNT_BIG(*) FROM NYCTaxi_Staging.clean.ValidTrip WHERE TaxiType='FHV');&#10;DECLARE @CleanHVFHV bigint=(SELECT COUNT_BIG(*) FROM NYCTaxi_Staging.clean.ValidTrip WHERE TaxiType='FHVHV');&#10;IF (SELECT COUNT_BIG(*) FROM dbo.Fact_YellowGreen_Trips)&lt;@CleanTaxi&#10; THROW 55041,'YellowGreen Fact is missing valid Clean trips.',1;&#10;IF (SELECT COUNT_BIG(*) FROM dbo.Fact_FHV_Trips)&lt;@CleanFHV&#10; THROW 55042,'FHV Fact is missing valid Clean trips.',1;&#10;IF (SELECT COUNT_BIG(*) FROM dbo.Fact_HVFHV_Trips)&lt;@CleanHVFHV&#10; THROW 55043,'HVFHV Fact is missing valid Clean trips.',1;&#10;IF EXISTS (SELECT 1 FROM dbo.Fact_YellowGreen_Trips WHERE ServiceTypeKey=0)&#10; OR EXISTS (SELECT 1 FROM dbo.Fact_FHV_Trips WHERE ServiceTypeKey=0)&#10; OR EXISTS (SELECT 1 FROM dbo.Fact_HVFHV_Trips WHERE ServiceTypeKey=0)&#10; THROW 55044, 'A Fact has unknown ServiceTypeKey.',1;&#10;-- Mark inferred monthly groups, without asserting any real file-level lineage.&#10;UPDATE D SET D.BatchStatus='SUCCEEDED',D.LoadedAt=SYSDATETIME()&#10;FROM dbo.Dim_LoadBatch D&#10;WHERE D.BatchID LIKE 'CLEAN-%' AND D.BatchStatus='READY';&#10;&#10;IF (SELECT COUNT_BIG(*) FROM dbo.Fact_YellowGreen_Trips)&lt;&gt;(SELECT COUNT_BIG(*) FROM NYCTaxi_Staging.clean.ValidTrip WHERE TaxiType IN('YELLOW','GREEN'))&#10; OR (SELECT COUNT_BIG(*) FROM dbo.Fact_FHV_Trips)&lt;&gt;(SELECT COUNT_BIG(*) FROM NYCTaxi_Staging.clean.ValidTrip WHERE TaxiType='FHV')&#10; OR (SELECT COUNT_BIG(*) FROM dbo.Fact_HVFHV_Trips)&lt;&gt;(SELECT COUNT_BIG(*) FROM NYCTaxi_Staging.clean.ValidTrip WHERE TaxiType='FHVHV')&#10; THROW 55912,'Exact clean-to-fact row reconciliation failed.',1;&#10;"/>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
