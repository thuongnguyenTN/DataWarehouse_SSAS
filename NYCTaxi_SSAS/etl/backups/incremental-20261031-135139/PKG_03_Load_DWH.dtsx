    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Constraint 4]" DTS:CreationName="" DTS:DTSID="{EC17AE8C-FA8B-4709-9740-5BBE6F6609C5}" DTS:From="Package\EST_03_Load_FactFHV" DTS:LogicalAnd="True" DTS:ObjectName="Constraint 4" DTS:To="Package\EST_04_Load_FactHVFHV"/>
    <DTS:PrecedenceConstraint DTS:refId="Package.PrecedenceConstraints[Constraint 5]" DTS:CreationName="" DTS:DTSID="{C5E83471-C313-4F78-9443-631F7F1ACE1C}" DTS:From="Package\EST_04_Load_FactHVFHV" DTS:LogicalAnd="True" DTS:ObjectName="Constraint 5" DTS:To="Package\EST_05_Validate_DWH"/>
