  <MdxScripts>
    <MdxScript dwd:design-time-name="429486c0-b30d-4084-a2b3-bfdf265c4c72">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[FHV Average Trip Duration Minutes] AS IIF(IsEmpty([Measures].[Fact FHV Trips TripDurationSecondsValidTrips]) OR [Measures].[Fact FHV Trips TripDurationSecondsValidTrips] = 0, NULL, ([Measures].[Trip Duration Seconds]) / ([Measures].[Fact FHV Trips TripDurationSecondsValidTrips]) * 0.016666666666666666), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'FHV', VISIBLE = 1;</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>
