            <QueryDefinition>SELECT * FROM dbo.[Fact_FHV_Trips] WHERE NOT ((PickupDateKey &gt;= 20250101 AND PickupDateKey &lt; 20250201) OR (PickupDateKey &gt;= 20250201 AND PickupDateKey &lt; 20250301) OR (PickupDateKey &gt;= 20250301 AND PickupDateKey &lt; 20250401) OR (PickupDateKey &gt;= 20250401 AND PickupDateKey &lt; 20250501) OR (PickupDateKey &gt;= 20250501 AND PickupDateKey &lt; 20250601) OR (PickupDateKey &gt;= 20250601 AND PickupDateKey &lt; 20250701) OR (PickupDateKey &gt;= 20250701 AND PickupDateKey &lt; 20250801) OR (PickupDateKey &gt;= 20250801 AND PickupDateKey &lt; 20250901) OR (PickupDateKey &gt;= 20250901 AND PickupDateKey &lt; 20251001) OR (PickupDateKey &gt;= 20251001 AND PickupDateKey &lt; 20251101) OR (PickupDateKey &gt;= 20251101 AND PickupDateKey &lt; 20251201) OR (PickupDateKey &gt;= 20251201 AND PickupDateKey &lt; 20260101))</QueryDefinition>
          </Source>
