      <MdxScripts>
        <MdxScript>
          <ID>MdxScript</ID>
          <Name>MdxScript</Name>
          <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
          <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
          <Commands>
            <Command>
              <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[YellowGreen Average Trip Duration Minutes] AS IIF(IsEmpty([Measures].[Fact Yellow Green Trips TripDurationSecondsValidTrips]) OR [Measures].[Fact Yellow Green Trips TripDurationSecondsValidTrips] = 0, NULL, ([Measures].[Trip Duration Seconds - Fact Yellow Green Trips]) / ([Measures].[Fact Yellow Green Trips TripDurationSecondsValidTrips]) * 0.016666666666666666), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'YellowGreen', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[YellowGreen Average Trip Distance] AS IIF(IsEmpty([Measures].[Fact Yellow Green Trips TripDistanceMilesValidTrips]) OR [Measures].[Fact Yellow Green Trips TripDistanceMilesValidTrips] = 0, NULL, ([Measures].[Trip Distance Miles - Fact Yellow Green Trips]) / ([Measures].[Fact Yellow Green Trips TripDistanceMilesValidTrips]) * 1), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'YellowGreen', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[YellowGreen Average Speed MPH] AS IIF(IsEmpty([Measures].[Fact Yellow Green Trips SpeedDurationSeconds]) OR [Measures].[Fact Yellow Green Trips SpeedDurationSeconds] = 0, NULL, ([Measures].[Fact Yellow Green Trips SpeedDistanceMiles]) / ([Measures].[Fact Yellow Green Trips SpeedDurationSeconds]) * 3600), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'YellowGreen', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[YellowGreen Average Fare Per Trip] AS IIF(IsEmpty([Measures].[Fact Yellow Green Trips FareAmountValidTrips]) OR [Measures].[Fact Yellow Green Trips FareAmountValidTrips] = 0, NULL, ([Measures].[Fare Amount]) / ([Measures].[Fact Yellow Green Trips FareAmountValidTrips]) * 1), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'YellowGreen', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[YellowGreen Average Tip Per Trip] AS IIF(IsEmpty([Measures].[Fact Yellow Green Trips TipAmountValidTrips]) OR [Measures].[Fact Yellow Green Trips TipAmountValidTrips] = 0, NULL, ([Measures].[Tip Amount - Fact Yellow Green Trips]) / ([Measures].[Fact Yellow Green Trips TipAmountValidTrips]) * 1), FORMAT_STRING = '#,##0.00', DISPLAY_FOLDER = 'YellowGreen', VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[YellowGreen Tip Percentage] AS IIF(IsEmpty([Measures].[Fact Yellow Green Trips TipPairFare]) OR [Measures].[Fact Yellow Green Trips TipPairFare] = 0, NULL, ([Measures].[Fact Yellow Green Trips TipPairAmount]) / ([Measures].[Fact Yellow Green Trips TipPairFare]) * 1), FORMAT_STRING = '0.00%', DISPLAY_FOLDER = 'YellowGreen', VISIBLE = 1;</Text>
            </Command>
          </Commands>
        </MdxScript>
      </MdxScripts>
    </Cube>
